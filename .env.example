NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://ecare:ecare_dev_only@localhost:5432/ecare_connect
DB_POOL_MAX=10
DB_SSL=false
CORS_ORIGIN=http://localhost:3000
# Configure a trusted OIDC provider before enabling authenticated clinical workflows.
OIDC_ISSUER=
OIDC_AUDIENCE=ecare-api
# Optional; if omitted, OIDC discovery metadata supplies jwks_uri.
OIDC_JWKS_URI=
